# Installed as /etc/kaart/kaart.env — owned by root, mode 0640, group kaart.
#
# systemd reads this via EnvironmentFile= in kaartd.service. The same file is
# understood by the binary directly, so `kaartd --env-file /etc/kaart/kaart.env`
# reproduces the service's configuration when debugging by hand.
#
# systemd does NOT expand $VARIABLES or run shell here. Values are literal.

KAART_DB=/var/lib/kaart/kaart.db

# Loopback only. nginx terminates TLS and authenticates; kaartd itself does not.
# Binding this to 0.0.0.0 publishes an unauthenticated read-write API.
KAART_ADDR=127.0.0.1:8080

# The web app is served from the same origin as the API
# (https://agent.mkzaman.com/kaartd/ and .../kaartd/api/), so the browser makes
# no cross-origin request and this is never consulted. It is set anyway so that
# a future split-origin setup fails visibly rather than silently.
KAART_CORS_ORIGINS=https://agent.mkzaman.com

KAART_LOG_LEVEL=info
