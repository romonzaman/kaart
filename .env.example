# Kaart server configuration.
#
# Copy to .env for local development; on a server this same format is read by
# systemd as /etc/kaart/kaart.env (see deploy/kaartd.service).
#
# Precedence: command-line flag > process environment > this file > default.
# A value already in the environment is never overwritten from here.

# SQLite database file. Created and migrated on first run. The *directory* must
# be writable too — SQLite writes -wal and -shm siblings next to it.
KAART_DB=./kaart.db

# Listen address.
#
# Keep this on loopback. kaartd has no authentication: every card and every
# review is readable and writable by anyone who can reach the port. On a server,
# bind loopback and put a reverse proxy with TLS and auth in front of it.
KAART_ADDR=127.0.0.1:8080

# Browser origins allowed to call the API, comma-separated. Must match the
# origin the web app is actually served from, scheme and port included.
KAART_CORS_ORIGINS=http://localhost:8081

# debug, info, warn, error
KAART_LOG_LEVEL=info
